<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com rescap">

  <!--
    Publisher must exactly match the CN of the signing certificate.
    The installer installs that cert to CurrentUser\TrustedPeople before
    calling Add-AppxPackage, so no Administrator elevation is needed.
  -->
  <Identity
    Name="NullIDE.ExplorerCommand"
    Publisher="CN=Null IDE"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Null IDE</DisplayName>
    <PublisherDisplayName>Null IDE</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Minimum: Windows 10 May 2019 Update (1903) for ExternalLocation support -->
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.18362.0"
      MaxVersionTested="10.0.65535.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!--
      Executable is relative to ExternalLocation (= the Null IDE install root).
      null.exe must be present there; this entry makes Windows aware of the app
      so it can display the correct name/icon in the Win11 context menu.
    -->
    <Application
      Id="NullIDE"
      Executable="null.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="Null IDE"
        Description="Code editor"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile />
      </uap:VisualElements>

      <Extensions>
        <!--
          Register the COM in-process DLL.
          Path is relative to ExternalLocation.
          DLL_UUID must match the DLL_UUID compile definition in CMakeLists.txt.
        -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:InProcessServer>
              <com:Path>shell-ext\NullIDE.ExplorerCommand\x64\null_explorer_command.dll</com:Path>
              <com:Class
                Id="A72D088B-AC8B-4AB5-ABFE-49C5CE37A466"
                ThreadingModel="STA" />
            </com:InProcessServer>
          </com:ComServer>
        </com:Extension>

        <!--
          Hook into the Win11 file/folder context menu.
          Both file and folder verbs map to the same COM class.
        -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="nullide-files" UseUrl="false">
            <uap:SupportedVerbs>
              <uap3:Verb Id="open" Parameters="%1"
                         MultiSelectModel="Player">Open in Null</uap3:Verb>
            </uap:SupportedVerbs>
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
