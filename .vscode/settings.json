{
    "markdown.validate.enabled": true,
    "actionButtons": {
        "commands": [
            {
                "name": "Sync Local",
                "color": "#4CAF50",
                "tooltip": "Run copy.ps1",
                "singleInstance": true,
                "command": "powershell -ExecutionPolicy Bypass ${workspaceFolder}\\copy.ps1"
            },
            {
                "name": "Reload IDE",
                "color": "#2196F3",
                "tooltip": "Reload the VS Code window",
                "singleInstance": true,
                "useVsCodeApi": true,
                "command": "workbench.action.reloadWindow"
            },
            {
                "cwd": "${workspaceFolder}",
                "name": "Push Tag",
                "color": "#00ff7f",
                "singleInstance": true,
                "command": "powershell.exe -ExecutionPolicy Bypass ${workspaceFolder}\\push-tag.ps1"
            },
            {
                "cwd": "${workspaceFolder}",
                "name": "Re-Push Tag",
                "color": "#2bc7fb",
                "singleInstance": true,
                "command": "powershell.exe -ExecutionPolicy Bypass ${workspaceFolder}\\repush-tag.ps1"
            }
        ],
        "defaultColor": "white",
        "reloadButton": "↻",
        "loadNpmCommands": false
    }
}