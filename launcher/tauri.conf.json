{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Null Launcher",
  "version": "0.1.0",
  "identifier": "dev.null-ide.launcher",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main", "title": "Null Launcher", "width": 640, "height": 460,
        "decorations": false, "alwaysOnTop": true, "skipTaskbar": true,
        "resizable": false, "center": true, "visible": false
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
