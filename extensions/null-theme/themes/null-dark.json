  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#505050", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#a6e3a1" }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#a8d8ff" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.delete",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#4d9ade", "fontStyle": "bold" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.separator"],
      "settings": { "foreground": "#a0a0a0" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": { "foreground": "#dcdcaa" }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.namespace",
        "entity.name.struct",
        "entity.name.enum",
        "support.class",
        "support.type"
      ],
      "settings": { "foreground": "#4ec9b0" }
    },
    {
      "name": "Constants and enumerators",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "variable.other.constant",
        "entity.name.enumerator"
      ],
      "settings": { "foreground": "#b5cea8" }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": { "foreground": "#9cdcfe" }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": ["variable.language"],
      "settings": { "foreground": "#4d9ade", "fontStyle": "italic" }
    },
    {
      "name": "Struct and object members",
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "support.variable.property",
        "meta.object.member"
      ],
      "settings": { "foreground": "#9cdcfe" }
    },
    {
      "name": "Preprocessor / macros",
      "scope": [
        "keyword.control.import",
        "keyword.control.include",
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": { "foreground": "#cba6f7" }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": { "foreground": "#dcdcaa", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation — brackets, parens",
      "scope": [
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.block",
        "punctuation.section"
      ],
      "settings": { "foreground": "#a0a0a0" }
    },
    {
      "name": "Tags (HTML/XML)",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#4d9ade" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#9cdcfe" }
    },
    {
      "name": "CSS property names",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#9cdcfe" }
    },
    {
      "name": "CSS property values",
      "scope": ["support.property-value.css", "constant.other.color.rgb-value"],
      "settings": { "foreground": "#b5cea8" }
    },
    {
      "name": "Invalid / deprecated",
      "scope": ["invalid"],
      "settings": { "foreground": "#f38ba8", "fontStyle": "underline" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#4d9ade", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#e0e0e0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#cba6f7", "fontStyle": "italic" }
    },
    {
      "name": "Markdown code spans",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#a6e3a1" }
    },
    {
      "name": "Markdown links",
      "scope": ["meta.link.inline", "markup.underline.link"],
      "settings": { "foreground": "#4d9ade" }
    }
  ],

  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#4ec9b0",
    "class": "#4ec9b0",
    "struct": "#4ec9b0",
    "enum": "#4ec9b0",
    "interface": "#4ec9b0",
    "typeParameter": "#4ec9b0",
    "type": "#4ec9b0",
    "function": "#dcdcaa",
    "method": "#dcdcaa",
    "macro": "#cba6f7",
    "variable": "#9cdcfe",
    "variable.readonly": "#b5cea8",
    "parameter": "#9cdcfe",
    "property": "#9cdcfe",
    "enumMember": "#b5cea8",
    "event": "#b5cea8",
    "keyword": { "foreground": "#4d9ade", "bold": true },
    "modifier": "#4d9ade",
    "comment": { "foreground": "#505050", "italic": true },
    "string": "#a6e3a1",
    "number": "#b5cea8",
    "regexp": "#a8d8ff",
    "operator": "#a0a0a0",
    "decorator": { "foreground": "#dcdcaa", "italic": true },
    "label": "#a0a0a0"
  }
}
