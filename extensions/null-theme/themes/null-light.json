  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6a9955", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#a31515" } },
    { "name": "String escapes", "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#ee4400" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "keyword.operator.new", "keyword.operator.delete", "storage.type", "storage.modifier"], "settings": { "foreground": "#0000ff" } },
    { "name": "Operators", "scope": ["keyword.operator", "punctuation.separator"], "settings": { "foreground": "#1a1a1a" } },
    { "name": "Functions", "scope": ["entity.name.function", "meta.function-call entity.name.function", "support.function"], "settings": { "foreground": "#795e26" } },
    { "name": "Classes", "scope": ["entity.name.class", "entity.name.type", "entity.name.namespace", "entity.name.struct", "entity.name.enum", "support.class", "support.type"], "settings": { "foreground": "#267f99" } },
    { "name": "Constants", "scope": ["constant", "constant.numeric", "constant.language", "variable.other.constant", "entity.name.enumerator"], "settings": { "foreground": "#098658" } },
    { "name": "Variables", "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable"], "settings": { "foreground": "#1a1a1a" } },
    { "name": "Language variables", "scope": ["variable.language"], "settings": { "foreground": "#0000ff", "fontStyle": "italic" } },
    { "name": "Members", "scope": ["variable.other.member", "variable.other.property", "support.variable.property", "meta.object.member"], "settings": { "foreground": "#001080" } },
    { "name": "Preprocessor", "scope": ["keyword.control.import", "keyword.control.include", "meta.preprocessor", "entity.name.function.preprocessor"], "settings": { "foreground": "#af00db" } },
    { "name": "Decorators", "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator", "storage.type.annotation"], "settings": { "foreground": "#795e26", "fontStyle": "italic" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#800000" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e50000" } },
    { "name": "CSS properties", "scope": ["support.type.property-name.css"], "settings": { "foreground": "#e50000" } },
    { "name": "CSS values", "scope": ["support.property-value.css", "constant.other.color.rgb-value"], "settings": { "foreground": "#098658" } },
    { "name": "Invalid", "scope": ["invalid"], "settings": { "foreground": "#cc2222", "fontStyle": "underline" } },
    { "name": "Markdown headings", "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#0000ff", "fontStyle": "bold" } },
    { "name": "Markdown bold", "scope": ["markup.bold"], "settings": { "foreground": "#1a1a1a", "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": ["markup.italic"], "settings": { "foreground": "#af00db", "fontStyle": "italic" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw", "markup.fenced_code.block"], "settings": { "foreground": "#a31515" } },
    { "name": "Markdown links", "scope": ["meta.link.inline", "markup.underline.link"], "settings": { "foreground": "#0056b3" } }
  ],

  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#267f99", "class": "#267f99", "struct": "#267f99", "enum": "#267f99",
    "interface": "#267f99", "typeParameter": "#267f99", "type": "#267f99",
    "function": "#795e26", "method": "#795e26", "macro": "#af00db",
    "variable": "#1a1a1a", "variable.readonly": "#098658",
    "parameter": "#1a1a1a", "property": "#001080", "enumMember": "#098658", "event": "#098658",
    "keyword": { "foreground": "#0000ff" }, "modifier": "#0000ff",
    "comment": { "foreground": "#6a9955", "italic": true },
    "string": "#a31515", "number": "#098658", "regexp": "#ee4400", "operator": "#1a1a1a",
    "decorator": { "foreground": "#795e26", "italic": true }, "label": "#1a1a1a"
  }
}
