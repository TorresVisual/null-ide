  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#006600", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#009922" } },
    { "name": "String escapes", "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#00cc99" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "keyword.operator.new", "keyword.operator.delete", "storage.type", "storage.modifier"], "settings": { "foreground": "#00ff41" } },
    { "name": "Operators", "scope": ["keyword.operator", "punctuation.separator"], "settings": { "foreground": "#00aa22" } },
    { "name": "Functions", "scope": ["entity.name.function", "meta.function-call entity.name.function", "support.function"], "settings": { "foreground": "#66ff88" } },
    { "name": "Classes", "scope": ["entity.name.class", "entity.name.type", "entity.name.namespace", "entity.name.struct", "entity.name.enum", "support.class", "support.type"], "settings": { "foreground": "#00cc99" } },
    { "name": "Constants", "scope": ["constant", "constant.numeric", "constant.language", "variable.other.constant", "entity.name.enumerator"], "settings": { "foreground": "#00cc33" } },
    { "name": "Variables", "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable"], "settings": { "foreground": "#00bb33" } },
    { "name": "Language variables", "scope": ["variable.language"], "settings": { "foreground": "#00ff41", "fontStyle": "italic" } },
    { "name": "Members", "scope": ["variable.other.member", "variable.other.property", "support.variable.property", "meta.object.member"], "settings": { "foreground": "#00bb33" } },
    { "name": "Preprocessor", "scope": ["keyword.control.import", "keyword.control.include", "meta.preprocessor", "entity.name.function.preprocessor"], "settings": { "foreground": "#00cc99" } },
    { "name": "Decorators", "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator", "storage.type.annotation"], "settings": { "foreground": "#66ff88", "fontStyle": "italic" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#00ff41" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#00bb33" } },
    { "name": "CSS properties", "scope": ["support.type.property-name.css"], "settings": { "foreground": "#00bb33" } },
    { "name": "CSS values", "scope": ["support.property-value.css", "constant.other.color.rgb-value"], "settings": { "foreground": "#00cc33" } },
    { "name": "Invalid", "scope": ["invalid"], "settings": { "foreground": "#ff3333", "fontStyle": "underline" } },
    { "name": "Markdown headings", "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#00ff41", "fontStyle": "bold" } },
    { "name": "Markdown bold", "scope": ["markup.bold"], "settings": { "foreground": "#66ff88", "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": ["markup.italic"], "settings": { "foreground": "#00cc99", "fontStyle": "italic" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw", "markup.fenced_code.block"], "settings": { "foreground": "#009922" } },
    { "name": "Markdown links", "scope": ["meta.link.inline", "markup.underline.link"], "settings": { "foreground": "#00ff41" } }
  ],

  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#00cc99", "class": "#00cc99", "struct": "#00cc99", "enum": "#00cc99",
    "interface": "#00cc99", "typeParameter": "#00cc99", "type": "#00cc99",
    "function": "#66ff88", "method": "#66ff88", "macro": "#00cc99",
    "variable": "#00bb33", "variable.readonly": "#00cc33",
    "parameter": "#00bb33", "property": "#00bb33", "enumMember": "#00cc33", "event": "#00cc33",
    "keyword": { "foreground": "#00ff41" }, "modifier": "#00ff41",
    "comment": { "foreground": "#006600", "italic": true },
    "string": "#009922", "number": "#00cc33", "regexp": "#00cc99", "operator": "#00aa22",
    "decorator": { "foreground": "#66ff88", "italic": true }, "label": "#00aa22"
  }
}
