{
  "name": "null-theme",
  "displayName": "Null Dark",
  "description": "Dark gray theme with minimal activity bar — built-in for Null IDE",
  "version": "1.0.0",
  "publisher": "null",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Null Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/null-dark.json"
      },
      {
        "label": "Null OLED",
        "uiTheme": "vs-dark",
        "path": "./themes/null-oled.json"
      },
      {
        "label": "Null Light",
        "uiTheme": "vs",
        "path": "./themes/null-light.json"
      },
      {
        "label": "Null Retro",
        "uiTheme": "vs-dark",
        "path": "./themes/null-retro.json"
      }
    ],

    "keybindings": [
      {
        "key": "ctrl+shift+a",
        "command": "workbench.action.terminal.newWithProfile",
        "args": { "profileName": "Claude Code" }
      }
    ],

    "configurationDefaults": {
      "workbench.colorTheme": "Null Dark",
      "workbench.startupEditor": "welcomePage",
      "workbench.tree.indent": 14,
      "workbench.editor.tabSizing": "shrink",
      "workbench.editor.showIcons": true,
      "workbench.iconTheme": "null-icons",
      "workbench.secondarySideBar.defaultVisibility": "hidden",
      "workbench.editorLargeFileConfirmation": 102400,

      "window.title": "${activeEditorShort}${separator}${rootName}",

      "editor.fontFamily": "'Geist Mono', 'JetBrains Mono', 'Cascadia Code', monospace",
      "editor.fontSize": 13,
      "editor.lineHeight": 1.65,
      "editor.fontLigatures": true,
      "editor.tabSize": 4,
      "editor.insertSpaces": true,
      "editor.detectIndentation": true,
      "editor.renderWhitespace": "boundary",
      "editor.minimap.enabled": false,
      "editor.padding.top": 8,
      "editor.scrollBeyondLastLine": false,
      "editor.cursorBlinking": "blink",
      "editor.cursorSmoothCaretAnimation": "off",
      "editor.smoothScrolling": true,
      "editor.formatOnSave": true,
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": "active",
      "editor.stickyScroll.enabled": true,
      "editor.inlayHints.enabled": "on",
      "editor.suggest.preview": true,
      "editor.acceptSuggestionOnCommitCharacter": true,

      "terminal.integrated.fontFamily": "'Geist Mono', 'JetBrains Mono', 'Cascadia Code', monospace",
      "terminal.integrated.fontSize": 13,
      "terminal.integrated.lineHeight": 1.3,
      "terminal.integrated.cursorBlinking": true,
      "terminal.integrated.smoothScrolling": true,
      "terminal.integrated.profiles.windows": {
        "Claude Code": {
          "path": "cmd.exe",
          "args": ["/k", "claude"],
          "icon": "hubot",
          "color": "terminal.ansiCyan"
        },
        "PowerShell": {
          "source": "PowerShell",
          "icon": "terminal-powershell"
        },
        "Command Prompt": {
          "path": "${env:windir}\\System32\\cmd.exe",
          "icon": "terminal-cmd"
        }
      },

      "files.autoSave": "afterDelay",
      "explorer.confirmDelete": false,
      "explorer.confirmDragAndDrop": false,
      "python.createEnvironment.trigger": "off",
      "claudeCode.preferredLocation": "panel",

      "C_Cpp.intelliSenseEngine": "disabled",
      "clangd.arguments": [
        "--header-insertion=never",
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed",
        "--pch-storage=memory"
      ],
      "clangd.onConfigChanged": "restart",

      "python.defaultInterpreterPath": "python",
      "python.analysis.typeCheckingMode": "basic",
      "python.analysis.autoImportCompletions": true,
      "python.analysis.inlayHints.functionReturnTypes": true,
      "python.analysis.inlayHints.variableTypes": false,
      "python.formatting.provider": "none",
      "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
      },

      "cmake.configureOnOpen": true,
      "cmake.buildDirectory": "${workspaceFolder}/build",

      "git.autofetch": true,
      "git.confirmSync": false,
      "git.enableSmartCommit": true
    }
  }
}
