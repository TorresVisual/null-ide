  "main": "./out/extension.js",
  "extensionKind": ["ui"],
  "extensionDependencies": ["null.null-accounts"],
  "scripts": {
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.webview-issues.json && tsc -p tsconfig.webview-issue-detail.json && tsc -p tsconfig.webview-dashboard.json && tsc -p tsconfig.webview-recent-projects.json && tsc -p tsconfig.webview-commit-graph.json",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.webview-shared.json && tsc -p tsconfig.webview-recent-projects.json && node --test out/commitMessage.test.js out/commitValidation.test.js out/recentProjects.test.js out/recentProjectsProjection.test.js out/dashboardLauncher.test.js out/scratchNotesStorage.test.js out/autoGitignore.test.js out/versionComparison.test.js out/nullNotes.test.js out/github/githubRemote.test.js out/github/issueFilter.test.js out/github/promptFormat.test.js out/github/gitBranch.test.js out/github/taskList.test.js out/github/issueTemplates.test.js out/dashboardGitStatus.test.js out/dashboardActions.test.js out/dashboardAccounts.test.js out/dashboardHome.test.js out/claudeTabIntegration.test.js out/worktrees.test.js out/followAlong.test.js out/whyIsThisHere.test.js out/github/githubApi.test.js out/webviewShared.test.js out/webviewDetail.test.js out/github/searchQuery.test.js out/github/githubQueries.test.js out/github/detailQueries.test.js out/webviewList.test.js out/github/recentlyCreated.test.js out/webviewComposer.test.js out/webviewCreate.test.js out/github/issueDrafts.test.js out/github/issueSuggest.test.js out/github/createExtras.test.js out/github/imageUrls.test.js out/github/imageCache.test.js out/github/imageUpload.test.js out/github/githubSession.test.js out/recovery/crashMarker.test.js out/recovery/interruptedSessions.test.js out/featureRegistry.test.js out/featureManifests.test.js out/graph/gitRun.test.js out/graph/gitLog.test.js out/graph/graphLayout.test.js out/graph/gitGraphService.test.js out/graph/gitActions.test.js out/graph/graphMessages.test.js out/webviewCommitGraph.test.js out/updateStatus.test.js out/firstRun.test.js out/dataDir.test.js out/pulls/pullModel.test.js out/pulls/pullDocs.test.js out/pulls/pullApi.test.js out/pulls/pullCheckout.test.js out/pulls/pullFilter.test.js out/pulls/pullDetailModel.test.js",
    "pretest:integration": "tsc -p tsconfig.json",
    "test:integration": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^11.8.0",
    "@types/mocha": "^10.0.10",
    "glob": "^13.0.6"
