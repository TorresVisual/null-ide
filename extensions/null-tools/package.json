  "activationEvents": ["onStartupFinished", "onCustomEditor:null.dashboard"],
  "nullWorkspace": {
    "features": [
      { "id": "dashboard", "label": "Dashboard", "category": "develop", "icon": "home",
        "command": "null.openDashboard", "description": "Projects & recent folders", "order": 10 },
      { "id": "issues", "label": "GitHub Issues", "category": "develop", "icon": "issues",
        "command": "null.issues.focus", "description": "Open the issues sidebar", "order": 20 },
      { "id": "graph", "label": "Commit Graph", "category": "develop", "icon": "git-commit",
        "command": "null.graph.open", "description": "Browse and act on git history", "order": 30 },
      { "id": "setup", "label": "Null Setup", "category": "setup", "icon": "settings-gear",
        "command": "null.setup.open", "description": "Shortcuts, built-ins, uninstall", "order": 5 },
      { "id": "pulls", "label": "Pull Requests", "category": "develop", "icon": "git-pull-request",
        "command": "null.pulls.open", "description": "Review pull requests in the editor", "order": 25 }
    ]
  },
  "contributes": {
