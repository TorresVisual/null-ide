      "webview/context": [
        { "command": "null.graph.checkout", "when": "webviewId == 'null.commitGraph' && webviewSection == 'commit' && !null.graph.operationInProgress", "group": "1_ops@1" },
        { "command": "null.graph.createBranch", "when": "webviewId == 'null.commitGraph' && webviewSection == 'commit' && !null.graph.operationInProgress", "group": "1_ops@2" },
        { "command": "null.graph.cherryPick", "when": "webviewId == 'null.commitGraph' && webviewSection == 'commit' && !null.graph.operationInProgress", "group": "2_edit@1" },
        { "command": "null.graph.revert", "when": "webviewId == 'null.commitGraph' && webviewSection == 'commit' && !null.graph.operationInProgress", "group": "2_edit@2" },
        { "submenu": "null.graph.resetMenu", "when": "webviewId == 'null.commitGraph' && webviewSection == 'commit' && !null.graph.operationInProgress", "group": "2_edit@3" },
        { "command": "null.graph.copySha", "when": "webviewId == 'null.commitGraph' && webviewSection == 'commit'", "group": "3_copy@1" }
      ],
      "null.graph.resetMenu": [
        { "command": "null.graph.reset.soft", "group": "1@1" },
        { "command": "null.graph.reset.mixed", "group": "1@2" },
        { "command": "null.graph.reset.hard", "group": "1@3" }
      ]
    },
    "configuration": {
      "title": "Null IDE",
      "properties": {
        "null.updates.check": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Check for a new Null IDE release when the IDE starts. The command \"Null: Check for Updates\" always works."
        },
        "null.recentProjects.maxItems": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Maximum number of unpinned projects retained by the Null recent-projects launcher. Pinned projects are always retained."
        },
        "null.plans.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open new Claude Code plan files as a Markdown preview."
        },
        "null.nullNotes.exePath": {
          "type": "string",
          "default": "",
          "description": "Path to null-notes.exe, used by \"Open in null-notes\". Leave empty to use the default per-user install location (%LOCALAPPDATA%\\null-notes\\null-notes.exe)."
        },
        "null.commitMessage.useClaude": {
          "type": "boolean",
          "default": true,
          "description": "Generate commit messages with the Claude CLI. When off, a basic message is built from the changed files and no Claude usage is spent."
        },
        "null.commitMessage.validation": {
          "type": "string",
          "enum": ["off", "warn", "strict"],
          "enumDescriptions": [
            "Do not check commit messages.",
            "Underline messages in the Source Control box that are not Conventional Commits (type(scope): description).",
            "Same as warn, and also refuse to commit such a message."
          ],
          "default": "warn",
          "description": "Check commit messages against the Conventional Commits format, whether typed by hand or generated."
        },
        "null.recovery.enabled": {
          "type": "boolean",
          "default": true,
          "description": "After an unexpected exit, offer to reopen the Claude Code conversations that were open (and flag those interrupted mid-turn). Unsaved editor contents are restored by VS Code itself and are not affected by this setting."
        },
        "null.gitignore.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan workspace for build artifacts and add missing entries to .gitignore."
        },
        "null.gitignore.autoCommit": {
          "type": "boolean",
          "default": true,
          "description": "Automatically commit .gitignore to Git when new entries are added by Null Auto-Gitignore."
        },
        "null.gitignore.ignoredPatterns": {
          "type": "array",
          "default": [
            "node_modules/",
            ".next/",
            ".nuxt/",
            ".turbo/",
            "__pycache__/",
            "lib/__pycache__/",
            ".pytest_cache/",
            ".mypy_cache/",
            "*.pyc",
            "*.pyo",
            "*.egg-info/",
            "tests/tmp/",
            ".venv/",
            "venv/",
            "env/",
            ".build-venv/",
            "dist/",
            "dist_web/",
            "build/",
            "build_web/",
            "out/",
            "target/",
            "bin/",
            "obj/",
            ".cache/",
            ".build-deps/",
            ".build-cache/",
            ".null/",
            ".DS_Store",
            "Thumbs.db",
            "*.log",
            ".env",
            ".env.local",
            ".env.development.local",
            ".env.test.local",
            ".env.production.local",
            ".claude/",
            ".codex-tmp/",
            ".superpowers/",
            ".playwright-mcp/"
          ],
          "markdownDescription": "File and directory patterns the workspace scan adds to `.gitignore` when found. Replaces the built-in list, so removing an entry stops it from being auto-ignored.",
          "items": { "type": "string" }
        },
        "null.ports.refreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "How often (in seconds) the Null Ports panel scans for active listening ports. Set to 0 to disable auto-refresh."
        },
        "null.ports.filterDevOnly": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, Null Ports only shows processes recognised as dev servers (node, python, ollama, etc.). Disable to show all listening ports."
        },
        "null.worktrees.copyFilesGlob": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Glob patterns for untracked setup files (e.g. .env, .claude/settings.local.json) to copy into every newly created worktree."
        },
        "null.discord.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Null IDE activity in Discord Rich Presence. Requires null.discord.clientId and Discord desktop app running."
        },
        "null.claude.followAlong": {
          "type": "boolean",
          "default": false,
          "description": "Watch the active Claude Code session's transcript and reveal + briefly highlight each file it edits, live in the editor."
        },
        "null.claude.followAlongSplitView": {
          "type": "boolean",
          "default": false,
          "description": "When Follow Along is on, always open the edited file in the second editor pane, leaving the first pane (e.g. your Claude Code tab) undisturbed."
        },
        "null.discord.clientId": {
          "type": "string",
          "default": "",
          "description": "Discord Application ID from the Discord Developer Portal (OAuth2 → Client ID). Name the application \"Null IDE\" — Discord shows the application's own name as \"Playing …\". Upload Rich Presence art assets named null (the large app icon), code, debug, and your language keys (typescript, python, etc.). Run \"Null: Test Discord Rich Presence\" to check the setup."
        },
        "null.discord.transport": {
          "type": "string",
          "enum": ["auto", "ipc", "websocket"],
          "default": "auto",
          "description": "How Null IDE connects to Discord. Use auto (default), ipc, or websocket if Rich Presence fails to connect."
        },
        "null.discord.showFileName": {
          "type": "boolean",
          "default": true,
          "description": "Show the active file name in Discord Rich Presence."
        },
        "null.discord.showWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Show the workspace or folder name in Discord Rich Presence."
        },
        "null.discord.privacyMode": {
          "type": "boolean",
          "default": false,
          "description": "Hide file names and show a generic \"Editing code\" message instead."
        },
        "null.discord.idleTimeoutSec": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Seconds without editor activity before switching to an idle presence. Set to 0 to disable idle detection."
        },
        "null.discord.showDebug": {
          "type": "boolean",
          "default": true,
          "description": "Show a debugging state when a debug session is active."
        },
        "null.discord.showRepositoryButton": {
          "type": "boolean",
          "default": true,
          "description": "Show a repository link button (e.g. View on GitHub). Private GitHub repos fall back to linking Null IDE, since their URL would 404 for anyone viewing your profile. Note: Discord never renders Rich Presence buttons on your own profile — check from a friend’s account or the mobile app."
        }
      }
    },
    "keybindings": [
      {
        "command": "null.generateCommitMessage",
        "key": "ctrl+shift+alt+g"
      }
    ]
  }
}
