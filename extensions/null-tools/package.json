        { "command": "null.graph.createBranch", "when": "view == null.graphView && viewItem == graphCommit && !null.graph.operationInProgress", "group": "1_ops@2" },
        { "command": "null.graph.cherryPick", "when": "view == null.graphView && viewItem == graphCommit && !null.graph.operationInProgress", "group": "2_edit@1" },
        { "command": "null.graph.revert", "when": "view == null.graphView && viewItem == graphCommit && !null.graph.operationInProgress", "group": "2_edit@2" },
        { "submenu": "null.graph.resetMenu", "when": "view == null.graphView && viewItem == graphCommit && !null.graph.operationInProgress", "group": "2_edit@3" },
        { "command": "null.graph.copySha", "when": "view == null.graphView && viewItem == graphCommit", "group": "3_copy@1" },
        { "command": "null.pulls.checkout", "when": "view == null.pullsView && viewItem == pull", "group": "inline@1" },
        { "command": "null.pulls.openOnGitHub", "when": "view == null.pullsView && viewItem == pull", "group": "inline@2" },
        { "command": "null.pulls.checkout", "when": "view == null.pullsView && viewItem == pull", "group": "1_pull@1" },
        { "command": "null.pulls.openOnGitHub", "when": "view == null.pullsView && viewItem == pull", "group": "1_pull@2" }
