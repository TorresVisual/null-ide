        { "command": "null.issues.create" },
        { "command": "null.issues.refresh" },
        { "command": "null.issues.openFullView" },
        { "command": "null.issues.signIn" },
        { "command": "null.issues.markRead" },
        { "command": "null.issues.linkFromCommitMessage" },
        { "command": "null.issues.insertReference" },
        { "command": "null.pulls.openFileDiff", "when": "false" },
        { "command": "null.pulls.comment", "when": "false" },
        { "command": "null.pulls.filter", "when": "false" },
        { "command": "null.pulls.resetFilter", "when": "false" },
        { "command": "null.graph.checkout", "when": "false" },
        { "command": "null.graph.createBranch", "when": "false" },
        { "command": "null.graph.cherryPick", "when": "false" },
        { "command": "null.graph.revert", "when": "false" },
        { "command": "null.graph.reset.soft", "when": "false" },
        { "command": "null.graph.reset.mixed", "when": "false" },
        { "command": "null.graph.reset.hard", "when": "false" },
        { "command": "null.graph.copySha", "when": "false" },
        { "command": "null.graph.continue", "when": "null.graph.operationInProgress" },
        { "command": "null.graph.skip", "when": "null.graph.operationInProgress" },
        { "command": "null.graph.abort", "when": "null.graph.operationInProgress" }
