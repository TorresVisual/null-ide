    "viewsContainers": {
      "activitybar": [
        {
          "id": "null-workspace",
          "title": "Null Workspace",
          "icon": "media/workspace.svg"
        },
        {
          "id": "null-issues",
          "title": "GitHub",
          "icon": "media/github-issues.svg"
        }
      ]
    },
    "views": {
      "null-workspace": [
        { "id": "null.featuresView", "name": "Features", "visibility": "visible" },
        { "id": "null.scratchView", "name": "Scratch Files", "visibility": "collapsed" },
        { "id": "null.notesView", "name": "Notes", "visibility": "collapsed" },
        { "id": "null.portsView", "name": "Null Ports", "visibility": "collapsed" },
        { "id": "null.worktreesView", "name": "Worktrees", "visibility": "collapsed" },
        { "id": "null.graphView", "name": "Recent Commits", "visibility": "collapsed" }
      ],
      "null-issues": [
        {
          "type": "webview",
          "id": "null.issuesView",
          "name": "GitHub Issues",
          "visibility": "visible"
        },
        { "id": "null.pullsView", "name": "Pull Requests", "visibility": "collapsed" }
      ]
    },
    "viewsWelcome": [
      { "view": "null.graphView", "contents": "The open folder is not a Git repository.\n[Initialize Repository](command:git.init)", "when": "null.graph.state == not-a-repo" },
      { "view": "null.graphView", "contents": "Git was not found. Install Git and reload the window.", "when": "null.graph.state == no-git" },
      { "view": "null.graphView", "contents": "Commit Graph isn't available in remote windows yet.", "when": "null.graph.state == remote" },
      { "view": "null.graphView", "contents": "Commit Graph doesn't run in an untrusted workspace.\n[Manage Workspace Trust](command:workbench.trust.manage)", "when": "null.graph.state == untrusted" },
      { "view": "null.graphView", "contents": "Open a folder to see its commit history.\n[Open Folder](command:workbench.action.files.openFolder)", "when": "null.graph.state == no-folder" },
      { "view": "null.pullsView", "contents": "Open a folder to see its pull requests.\n[Open Folder](command:workbench.action.files.openFolder)", "when": "null.pulls.state == no-folder" },
      { "view": "null.pullsView", "contents": "Pull Requests aren't available in remote windows yet.", "when": "null.pulls.state == remote" },
      { "view": "null.pullsView", "contents": "Pull Requests don't run in an untrusted workspace.\n[Manage Workspace Trust](command:workbench.trust.manage)", "when": "null.pulls.state == untrusted" },
      { "view": "null.pullsView", "contents": "The open folder is not a Git repository.\n[Initialize Repository](command:git.init)", "when": "null.pulls.state == not-a-repo" },
      { "view": "null.pullsView", "contents": "Git was not found. Install Git and reload the window.", "when": "null.pulls.state == no-git" },
      { "view": "null.pullsView", "contents": "The `origin` remote of the open folder is not on github.com.", "when": "null.pulls.state == no-repo" },
      { "view": "null.pullsView", "contents": "Sign in to GitHub to see this repository's pull requests.\n[Sign In](command:null.issues.signIn)", "when": "null.pulls.state == signed-out" },
      { "view": "null.pullsView", "contents": "Could not load pull requests.\n[Try Again](command:null.pulls.refresh)", "when": "null.pulls.state == error" },
      { "view": "null.pullsView", "contents": "No open pull requests.", "when": "null.pulls.state == empty" },
      { "view": "null.pullsView", "contents": "No pull requests match the filters.\n[Change Filters](command:null.pulls.filter)\n[Reset Filters](command:null.pulls.resetFilter)", "when": "null.pulls.state == empty-filtered" }
    ],
    "submenus": [
      { "id": "null.graph.resetMenu", "label": "Reset Current Branch To Here" }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "null.runScratchFile",
          "when": "null.canRunScratchFile",
          "group": "navigation"
        },
        {
          "command": "null.openInNullNotes",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "null.openInNullNotes",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "null.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "command": "null.issues.linkFromCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "command": "null.issues.insertReference",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "null.newScratchFile",
          "when": "view == null.scratchView",
          "group": "navigation"
        },
        {
          "command": "null.newNote",
          "when": "view == null.notesView",
          "group": "navigation"
        },
        {
          "command": "null.ports.refresh",
          "when": "view == null.portsView",
          "group": "navigation"
        },
        {
          "command": "null.worktrees.new",
          "when": "view == null.worktreesView",
          "group": "navigation"
        },
        {
          "command": "null.worktrees.refresh",
          "when": "view == null.worktreesView",
          "group": "navigation"
        },
        {
          "command": "null.worktrees.prune",
          "when": "view == null.worktreesView",
          "group": "navigation"
        },
        { "command": "null.graph.open", "when": "view == null.graphView", "group": "navigation@1" },
        { "command": "null.graph.refresh", "when": "view == null.graphView", "group": "navigation@2" },
        { "command": "null.pulls.filter", "when": "view == null.pullsView && null.pulls.state =~ /^(ready|empty|empty-filtered)$/", "group": "navigation@1" },
        { "command": "null.pulls.refresh", "when": "view == null.pullsView", "group": "navigation@2" }
      ],
      "view/item/context": [
        {
          "command": "null.renameScratchOrNoteItem",
          "when": "view == null.scratchView && viewItem == nullFolderItem",
          "group": "inline@1"
        },
        {
          "command": "null.renameScratchOrNoteItem",
          "when": "view == null.notesView && viewItem == nullFolderItem",
          "group": "inline@1"
        },
        {
          "command": "null.deleteScratchOrNoteItem",
          "when": "view == null.scratchView && viewItem == nullFolderItem",
          "group": "inline@2"
        },
        {
          "command": "null.deleteScratchOrNoteItem",
          "when": "view == null.notesView && viewItem == nullFolderItem",
          "group": "inline@2"
        },
        {
          "command": "null.ports.openInBrowser",
