{
  "name": "null-tools",
  "displayName": "Null Tools",
  "description": "IDE commands and productivity tools for Null IDE",
  "version": "1.0.0",
  "publisher": "null",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.webview-issues.json && tsc -p tsconfig.webview-issue-detail.json && tsc -p tsconfig.webview-dashboard.json",
    "test": "tsc -p tsconfig.json && node --test out/recentProjects.test.js out/scratchNotesStorage.test.js out/autoGitignore.test.js out/versionComparison.test.js out/nullNotes.test.js out/github/githubRemote.test.js out/github/issueFilter.test.js out/github/promptFormat.test.js out/github/gitBranch.test.js out/github/taskList.test.js out/github/issueTemplates.test.js out/dashboardGitStatus.test.js out/dashboardActions.test.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1"
  },
  "activationEvents": ["onStartupFinished", "onCustomEditor:null.dashboard"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "null.dashboard",
        "displayName": "Null Dashboard",
        "selector": [{ "filenamePattern": "null-dashboard:/**" }],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "null.generateCommitMessage",
        "title": "Null: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "null.checkForUpdates",
        "title": "Null: Check for Updates",
        "icon": "$(cloud-download)"
      },
      {
        "command": "null.installUpdate",
        "title": "Null: Install Update",
        "icon": "$(cloud-download)"
      },
      {
        "command": "null.agentsPaste",
        "title": "Null: Paste into AI Agents Terminal"
      },
      {
        "command": "null.clearWebviewCache",
        "title": "Null: Clear Webview Cache and Reload"
      },
      {
        "command": "null.showWelcome",
        "title": "Null: Show Welcome Page"
      },
      {
        "command": "null.toggleSoundDesign",
        "title": "Null: Toggle Sound Design"
      },
      {
        "command": "null.ollamaModel",
        "title": "Null: Switch Ollama Model",
        "icon": "$(list-selection)"
      },
      {
        "command": "null.ollamaChat",
        "title": "Null: Ask Ollama (inline chat)",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "null.ollamaReview",
        "title": "Null: Ollama Code Review",
        "icon": "$(search)"
      },
      {
        "command": "null.insertPromptTemplate",
        "title": "Null: Insert Prompt Template",
        "icon": "$(library)"
      },
      {
        "command": "null.injectContext",
        "title": "Null: Inject File Context into Agent",
        "icon": "$(file-code)"
      },
      {
        "command": "null.revertAgentChange",
        "title": "Null: Revert Agent Change"
      },
      {
        "command": "null.acceptProposedDiff",
        "title": "Accept Changes",
        "icon": "$(check)"
      },
      {
        "command": "null.rejectProposedDiff",
        "title": "Reject Changes",
        "icon": "$(discard)"
      },
      {
        "command": "null.newScratchFile",
        "title": "Null: New Scratch File",
        "icon": "$(new-file)"
      },
      {
        "command": "null.newNote",
        "title": "Null: New Note",
        "icon": "$(new-file)"
      },
      {
        "command": "null.autoGitignore",
        "title": "Null: Auto-Scan & Update .gitignore",
        "icon": "$(eye-closed)"
      },
      {
        "command": "null.renameScratchOrNoteItem",
        "title": "Null: Rename Item"
      },
      {
        "command": "null.deleteScratchOrNoteItem",
        "title": "Null: Delete Item"
      },
      {
        "command": "null.runScratchFile",
        "title": "Null: Run Scratch File",
        "icon": "$(play)"
      },
      {
        "command": "null.ports.refresh",
        "title": "Null: Refresh Ports",
        "icon": "$(refresh)"
      },
      {
        "command": "null.ports.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "null.ports.killProcess",
        "title": "Kill Process",
        "icon": "$(trash)"
      },
      {
        "command": "null.ports.copyUrl",
        "title": "Copy URL",
        "icon": "$(copy)"
      },
      {
        "command": "null.toggleDiscordPresence",
        "title": "Null: Toggle Discord Rich Presence",
        "icon": "$(broadcast)"
      },
      {
        "command": "null.discord.testConnection",
        "title": "Null: Test Discord Rich Presence",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "null.openInNullNotes",
        "title": "Null: Open in null-notes",
        "icon": "media/null-notes.svg"
      },
      {
        "command": "null.issues.create",
        "title": "Null: New GitHub Issue",
        "icon": "$(add)"
      },
      {
        "command": "null.issues.refresh",
        "title": "Null: Refresh GitHub Issues",
        "icon": "$(refresh)"
      },
      {
        "command": "null.issues.signIn",
        "title": "Null: Sign in to GitHub"
      },
      {
        "command": "null.issues.markRead",
        "title": "Null: Mark Issues as Read"
      },
      {
        "command": "null.issues.linkFromCommitMessage",
        "title": "Null: Open Issue Referenced in Commit Message",
        "icon": "$(issues)"
      },
      {
        "command": "null.issues.insertReference",
        "title": "Null: Insert Issue Reference into Commit Message",
        "icon": "$(references)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "null-workspace",
          "title": "Null Workspace",
          "icon": "media/workspace.svg"
        },
        {
          "id": "null-issues",
          "title": "GitHub Issues",
          "icon": "media/github-issues.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "null-agents",
          "title": "AI Agents",
          "icon": "media/null.svg"
        }
      ]
    },
    "views": {
      "null-agents": [
        {
          "type": "webview",
          "id": "null.agentsView",
          "name": "Claude Code",
          "visibility": "visible"
        }
      ],
      "null-workspace": [
        {
          "id": "null.scratchView",
          "name": "Scratch Files"
        },
        {
          "id": "null.notesView",
          "name": "Notes"
        },
        {
          "id": "null.portsView",
          "name": "Null Ports"
        }
      ],
      "null-issues": [
        {
          "type": "webview",
          "id": "null.issuesView",
          "name": "GitHub Issues",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "null.acceptProposedDiff",
          "when": "null.viewingProposedDiff",
          "group": "navigation"
        },
        {
          "command": "null.rejectProposedDiff",
          "when": "null.viewingProposedDiff",
          "group": "navigation"
        },
        {
          "command": "null.runScratchFile",
          "when": "null.canRunScratchFile",
          "group": "navigation"
        },
        {
          "command": "null.openInNullNotes",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "null.openInNullNotes",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "null.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "command": "null.issues.linkFromCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "command": "null.issues.insertReference",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "null.injectContext",
          "when": "view == null.agentsView",
          "group": "navigation@1"
        },
        {
          "command": "null.insertPromptTemplate",
          "when": "view == null.agentsView",
          "group": "navigation@2"
        },
        {
          "command": "null.ollamaModel",
          "when": "view == null.agentsView",
          "group": "navigation@3"
        },
        {
          "command": "null.newScratchFile",
          "when": "view == null.scratchView",
          "group": "navigation"
        },
        {
          "command": "null.newNote",
          "when": "view == null.notesView",
          "group": "navigation"
        },
        {
          "command": "null.ports.refresh",
          "when": "view == null.portsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "null.renameScratchOrNoteItem",
          "when": "view == null.scratchView && viewItem == nullFolderItem",
          "group": "inline@1"
        },
        {
          "command": "null.renameScratchOrNoteItem",
          "when": "view == null.notesView && viewItem == nullFolderItem",
          "group": "inline@1"
        },
        {
          "command": "null.deleteScratchOrNoteItem",
          "when": "view == null.scratchView && viewItem == nullFolderItem",
          "group": "inline@2"
        },
        {
          "command": "null.deleteScratchOrNoteItem",
          "when": "view == null.notesView && viewItem == nullFolderItem",
          "group": "inline@2"
        },
        {
          "command": "null.ports.openInBrowser",
          "when": "view == null.portsView && viewItem == portEntry",
          "group": "inline@1"
        },
        {
          "command": "null.ports.copyUrl",
          "when": "view == null.portsView && viewItem == portEntry",
          "group": "inline@2"
        },
        {
          "command": "null.ports.killProcess",
          "when": "view == null.portsView && viewItem == portEntry",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        { "command": "null.checkForUpdates" },
        { "command": "null.installUpdate", "when": "nullUpdateAvailable" },
        { "command": "null.agentsPaste" },
        { "command": "null.clearWebviewCache" },
        { "command": "null.showWelcome" },
        { "command": "null.toggleSoundDesign" },
        { "command": "null.ollamaModel" },
        { "command": "null.ollamaChat" },
        { "command": "null.ollamaReview" },
        { "command": "null.insertPromptTemplate" },
        { "command": "null.injectContext" },
        { "command": "null.newScratchFile" },
        { "command": "null.newNote" },
        { "command": "null.renameScratchOrNoteItem", "when": "false" },
        { "command": "null.deleteScratchOrNoteItem", "when": "false" },
        { "command": "null.runScratchFile", "when": "null.canRunScratchFile" },
        { "command": "null.ports.refresh" },
        { "command": "null.ports.openInBrowser" },
        { "command": "null.ports.killProcess" },
        { "command": "null.ports.copyUrl" },
        { "command": "null.toggleDiscordPresence" },
        { "command": "null.discord.testConnection" },
        { "command": "null.issues.create" },
        { "command": "null.issues.refresh" },
        { "command": "null.issues.signIn" },
        { "command": "null.issues.markRead" },
        { "command": "null.issues.linkFromCommitMessage" },
        { "command": "null.issues.insertReference" }
      ]
    },
    "configuration": {
      "title": "Null IDE",
      "properties": {
        "null.soundDesign.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable subtle UI sound effects (requires AI Agents panel to be open)."
        },
        "null.soundDesign.volume": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Sound design volume (0–1)."
        },
        "null.ollama.model": {
          "type": "string",
          "default": "llama3.2",
          "description": "Default Ollama model to use for the ollama agent tab and AI commands."
        },
        "null.plans.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open new Claude Code plan files as a Markdown preview."
        },
        "null.agentFileWatch.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show diffs and offer revert when an agent terminal modifies workspace files."
        },
        "null.nullNotes.exePath": {
          "type": "string",
          "default": "",
          "description": "Path to null-notes.exe, used by \"Open in null-notes\". Leave empty to use the default per-user install location (%LOCALAPPDATA%\\null-notes\\null-notes.exe)."
        },
        "null.promptTemplates": {
          "type": "array",
          "default": [
            { "label": "Explain this", "text": "Explain the following code:\n\n" },
            { "label": "Write tests for", "text": "Write unit tests for:\n\n" },
            { "label": "Review for bugs", "text": "Review this code carefully for bugs and improvements:\n\n" },
            { "label": "Refactor", "text": "Refactor the following code for clarity and maintainability:\n\n" }
          ],
          "description": "Prompt templates available via the Insert Prompt Template command.",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "text":  { "type": "string" }
            }
          }
        },
        "null.gitignore.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan workspace for build artifacts and add missing entries to .gitignore."
        },
        "null.gitignore.autoCommit": {
          "type": "boolean",
          "default": true,
          "description": "Automatically commit .gitignore to Git when new entries are added by Null Auto-Gitignore."
        },
        "null.gitignore.ignoredPatterns": {
          "type": "array",
          "default": [],
          "description": "Additional custom file or directory patterns to automatically scan and add to .gitignore.",
          "items": { "type": "string" }
        },
        "null.ports.refreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "How often (in seconds) the Null Ports panel scans for active listening ports. Set to 0 to disable auto-refresh."
        },
        "null.ports.filterDevOnly": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, Null Ports only shows processes recognised as dev servers (node, python, ollama, etc.). Disable to show all listening ports."
        },
        "null.discord.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Null IDE activity in Discord Rich Presence. Requires null.discord.clientId and Discord desktop app running."
        },
        "null.discord.clientId": {
          "type": "string",
          "default": "",
          "description": "Discord Application ID from the Discord Developer Portal (OAuth2 → Client ID). Name the application \"Null IDE\" — Discord shows the application's own name as \"Playing …\". Upload Rich Presence art assets named null (the large app icon), code, debug, and your language keys (typescript, python, etc.). Run \"Null: Test Discord Rich Presence\" to check the setup."
        },
        "null.discord.transport": {
          "type": "string",
          "enum": ["auto", "ipc", "websocket"],
          "default": "auto",
          "description": "How Null IDE connects to Discord. Use auto (default), ipc, or websocket if Rich Presence fails to connect."
        },
        "null.discord.showFileName": {
          "type": "boolean",
          "default": true,
          "description": "Show the active file name in Discord Rich Presence."
        },
        "null.discord.showWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Show the workspace or folder name in Discord Rich Presence."
        },
        "null.discord.privacyMode": {
          "type": "boolean",
          "default": false,
          "description": "Hide file names and show a generic \"Editing code\" message instead."
        },
        "null.discord.idleTimeoutSec": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Seconds without editor activity before switching to an idle presence. Set to 0 to disable idle detection."
        },
        "null.discord.showDebug": {
          "type": "boolean",
          "default": true,
          "description": "Show a debugging state when a debug session is active."
        },
        "null.discord.showRepositoryButton": {
          "type": "boolean",
          "default": true,
          "description": "Show a repository link button (e.g. View on GitHub). Private GitHub repos fall back to linking Null IDE, since their URL would 404 for anyone viewing your profile. Note: Discord never renders Rich Presence buttons on your own profile — check from a friend’s account or the mobile app."
        }
      }
    },
    "keybindings": [
      {
        "command": "null.generateCommitMessage",
        "key": "ctrl+shift+alt+g"
      },
      {
        "command": "null.agentsPaste",
        "key": "ctrl+v",
        "when": "focusedView == 'null.agentsView'"
      },
      {
        "command": "null.ollamaChat",
        "key": "ctrl+shift+o"
      },
      {
        "command": "null.injectContext",
        "key": "ctrl+shift+k",
        "when": "editorFocus || focusedView == 'null.agentsView'"
      }
    ]
  }
}
