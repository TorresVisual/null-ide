{
  "name": "null-music",
  "displayName": "Null Music",
  "description": "Clean, distraction-free local music player for Null IDE — controls, folders, playlists, search, and status bar display",
  "version": "1.0.0",
  "publisher": "null",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "main": "./out/extension.js",
  "extensionKind": ["ui"],
  "activationEvents": [
    "onStartupFinished",
    "onView:null.musicView"
  ],
  "nullWorkspace": {
    "features": [
      { "id": "music", "label": "Music Player", "category": "develop", "icon": "music",
        "command": "null-music.focus", "description": "Local music player", "order": 40 }
    ]
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "null-music",
          "title": "Music",
          "icon": "media/music.svg"
        }
      ]
    },
    "views": {
      "null-music": [
        {
          "type": "webview",
          "id": "null.musicView",
          "name": "Music Player"
        }
      ]
    },
    "commands": [
      {
        "command": "null-music.playPause",
        "title": "Null Music: Play / Pause",
        "icon": "$(play)"
      },
      {
        "command": "null-music.play",
        "title": "Null Music: Play",
        "icon": "$(play)"
      },
      {
        "command": "null-music.pause",
        "title": "Null Music: Pause",
        "icon": "$(debug-pause)"
      },
      {
        "command": "null-music.nextTrack",
        "title": "Null Music: Next Track",
        "icon": "$(chevron-right)"
      },
      {
        "command": "null-music.previousTrack",
        "title": "Null Music: Previous Track",
        "icon": "$(chevron-left)"
      },
      {
        "command": "null-music.seek",
        "title": "Null Music: Seek Track Position"
      },
      {
        "command": "null-music.setVolume",
        "title": "Null Music: Set Volume"
      },
      {
        "command": "null-music.volumeUp",
        "title": "Null Music: Volume Up"
      },
      {
        "command": "null-music.volumeDown",
        "title": "Null Music: Volume Down"
      },
      {
        "command": "null-music.toggleShuffle",
        "title": "Null Music: Toggle Shuffle"
      },
      {
        "command": "null-music.toggleRepeat",
        "title": "Null Music: Toggle Repeat Mode"
      },
      {
        "command": "null-music.likeCurrentTrack",
        "title": "Null Music: Like / Favorite Current Track",
        "icon": "$(heart)"
      },
      {
        "command": "null-music.showCurrentTrack",
        "title": "Null Music: Show Currently Playing Track"
      },
      {
        "command": "null-music.search",
        "title": "Null Music: Search Local Music",
        "icon": "$(search)"
      },
      {
        "command": "null-music.browsePlaylists",
        "title": "Null Music: Browse Music Folders",
        "icon": "$(list-unordered)"
      },
      {
        "command": "null-music.openLocalFolder",
        "title": "Null Music: Add Music Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "null-music.importPlaylist",
        "title": "Null Music: Import Playlist (.m3u8)",
        "icon": "$(list-ordered)"
      },
      {
        "command": "null-music.focus",
        "title": "Null Music: Open Music Player View",
        "icon": "media/music.svg"
      },
      { "command": "null-music.track.playNext", "title": "Null Music: Play Next" },
      { "command": "null-music.track.addToQueue", "title": "Null Music: Add to Queue" },
      { "command": "null-music.track.favorite", "title": "Null Music: Like / Unlike" },
      { "command": "null-music.track.reveal", "title": "Null Music: Reveal in File Explorer" }
    ],
    "menus": {
      "webview/context": [
        { "command": "null-music.track.playNext", "when": "webviewId == 'null.musicView' && webviewSection == 'track'", "group": "1_queue@1" },
        { "command": "null-music.track.addToQueue", "when": "webviewId == 'null.musicView' && webviewSection == 'track'", "group": "1_queue@2" },
        { "command": "null-music.track.favorite", "when": "webviewId == 'null.musicView' && webviewSection == 'track'", "group": "2_library@1" },
        { "command": "null-music.track.reveal", "when": "webviewId == 'null.musicView' && webviewSection == 'track'", "group": "3_file@1" }
      ],
      "commandPalette": [
        { "command": "null-music.track.playNext", "when": "false" },
        { "command": "null-music.track.addToQueue", "when": "false" },
        { "command": "null-music.track.favorite", "when": "false" },
        { "command": "null-music.track.reveal", "when": "false" }
      ],
      "view/title": [
        {
          "command": "null-music.search",
          "when": "view == null.musicView",
          "group": "navigation@1"
        },
        {
          "command": "null-music.openLocalFolder",
          "when": "view == null.musicView",
          "group": "navigation@2"
        },
        {
          "command": "null-music.previousTrack",
          "when": "view == null.musicView",
          "group": "navigation@3"
        },
        {
          "command": "null-music.playPause",
          "when": "view == null.musicView",
          "group": "navigation@4"
        },
        {
          "command": "null-music.nextTrack",
          "when": "view == null.musicView",
          "group": "navigation@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "null-music.playPause",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      },
      {
        "command": "null-music.nextTrack",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right"
      },
      {
        "command": "null-music.previousTrack",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left"
      },
      {
        "command": "null-music.volumeUp",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up"
      },
      {
        "command": "null-music.volumeDown",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down"
      },
      {
        "command": "null-music.likeCurrentTrack",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "null-music.focus",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Null Music",
      "properties": {
        "null-music.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Display currently playing track in the status bar."
        },
        "null-music.statusBar.showControls": {
          "type": "boolean",
          "default": false,
          "description": "Show dedicated playback buttons (Previous, Play/Pause, Next) in the status bar."
        },
        "null-music.statusBar.format": {
          "type": "string",
          "default": "${title} - ${artist}",
          "description": "Format string for the status bar. Available variables: ${title}, ${artist}, ${album}."
        },
        "null-music.notifications.showOnSongChange": {
          "type": "boolean",
          "default": false,
          "description": "Show a toast notification when the playing song changes."
        },
        "null-music.local.supportedExtensions": {
          "type": "array",
          "items": { "type": "string" },
          "default": [".mp3", ".flac", ".ogg", ".wav", ".m4a", ".aac", ".opus"],
          "description": "List of audio file extensions to include when scanning local music folders."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.webview-music-shared.json && tsc -p tsconfig.webview-music.json",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.webview-music-shared.json && tsc -p tsconfig.webview-music.json && node --test out/test/queue.test.js out/test/tagReader.test.js out/test/libraryCache.test.js out/test/library.test.js out/test/player.test.js out/test/webviewAudioOutput.test.js out/test/statusBarController.test.js out/test/musicHtml.test.js out/test/musicViewProvider.test.js out/test/commands.test.js out/test/m3uParser.test.js out/test/uri.test.js out/test/webviewDom.test.js out/test/webviewModel.test.js"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0"
  }
}
