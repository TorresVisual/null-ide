{
  "name": "null-database",
  "displayName": "Null Database",
  "description": "Built-in database viewer and SQL query runner for Null IDE",
  "version": "1.0.0",
  "publisher": "null",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:null.database.viewer",
    "onView:null.databaseExplorer",
    "onCommand:null.database.open",
    "workspaceContains:**/*.{db,sqlite,sqlite3,db3,sdb}"
  ],
  "nullWorkspace": {
    "features": [
      {
        "id": "database",
        "label": "Database Viewer",
        "category": "develop",
        "icon": "database",
        "command": "null.database.open",
        "description": "Browse and query databases",
        "order": 35
      }
    ]
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "null.database.viewer",
        "displayName": "Null Database Viewer",
        "selector": [
          {
            "filenamePattern": "*.{db,sqlite,sqlite3,db3,sdb}"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "null-databases",
          "title": "Databases",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "null-databases": [
        {
          "id": "null.databaseExplorer",
          "name": "Databases"
        }
      ]
    },
    "commands": [
      {
        "command": "null.database.open",
        "title": "Null Database: Open Database",
        "icon": "$(database)"
      },
      {
        "command": "null.database.openTable",
        "title": "Null Database: View Table Data",
        "icon": "$(table)"
      },
      {
        "command": "null.database.queryTable",
        "title": "Null Database: Query Table",
        "icon": "$(terminal)"
      },
      {
        "command": "null.database.newQuery",
        "title": "Null Database: New SQL Query",
        "icon": "$(plus)"
      },
      {
        "command": "null.database.refresh",
        "title": "Null Database: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "null.database.addConnection",
        "title": "Null Database: Add Database...",
        "icon": "$(plus)"
      },
      {
        "command": "null.database.removeConnection",
        "title": "Null Database: Remove Database",
        "icon": "$(close)"
      },
      {
        "command": "null.database.copyTableName",
        "title": "Null Database: Copy Table Name",
        "icon": "$(copy)"
      },
      {
        "command": "null.database.exportTable",
        "title": "Null Database: Export Table Data",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "null.database.addConnection",
          "when": "view == null.databaseExplorer",
          "group": "navigation@1"
        },
        {
          "command": "null.database.refresh",
          "when": "view == null.databaseExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "null.database.openTable",
          "when": "view == null.databaseExplorer && viewItem == table",
          "group": "inline@1"
        },
        {
          "command": "null.database.queryTable",
          "when": "view == null.databaseExplorer && viewItem == table",
          "group": "inline@2"
        },
        {
          "command": "null.database.copyTableName",
          "when": "view == null.databaseExplorer && viewItem == table",
          "group": "1_actions@1"
        },
        {
          "command": "null.database.exportTable",
          "when": "view == null.databaseExplorer && viewItem == table",
          "group": "1_actions@2"
        },
        {
          "command": "null.database.open",
          "when": "view == null.databaseExplorer && viewItem == database",
          "group": "inline@1"
        },
        {
          "command": "null.database.newQuery",
          "when": "view == null.databaseExplorer && viewItem == database",
          "group": "inline@2"
        },
        {
          "command": "null.database.removeConnection",
          "when": "view == null.databaseExplorer && viewItem == databaseConnection",
          "group": "2_manage"
        }
      ],
      "explorer/context": [
        {
          "command": "null.database.open",
          "when": "resourceExtname =~ /^\\.(db|sqlite|sqlite3|db3|sdb)$/i",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test out/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/vscode": "^1.93.0",
    "@types/node": "^22.0.0"
  }
}
