{
	"name": "null-markdown",
	"displayName": "Null Markdown",
	"description": "Enhanced markdown preview for Null IDE: GFM, task lists, Mermaid, KaTeX, GitHub Alerts",
	"version": "1.1.0",
	"publisher": "null",
	"license": "MIT",
	"engines": {
		"vscode": "^1.85.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:markdown",
		"onCommand:markdown.showPreview",
		"onCommand:markdown.showPreviewToSide"
	],
	"contributes": {
		"customEditors": [
			{
				"viewType": "null-markdown.editor",
				"displayName": "Markdown Editor",
				"selector": [{ "filenamePattern": "*.md" }],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "null-markdown.openPreview",
				"title": "Open Null Markdown Preview",
				"category": "Markdown",
				"icon": "$(open-preview)"
			},
			{
				"command": "null-markdown.openEditor",
				"title": "Open Markdown Editor",
				"category": "Markdown",
				"icon": "$(open-preview)"
			},
			{
				"command": "null-markdown.openSource",
				"title": "Open Markdown Source",
				"category": "Markdown",
				"icon": "$(code)"
			},
			{
				"command": "null-markdown.exportPdf",
				"title": "Export to PDF (Print)",
				"category": "Markdown",
				"icon": "$(file-pdf)"
			},
			{
				"command": "null-markdown.openSlides",
				"title": "Open as Presentation",
				"category": "Markdown",
				"icon": "$(play)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "null-markdown.openEditor",
					"when": "resourceLangId == markdown && !activeCustomEditorId",
					"group": "navigation@1"
				},
				{
					"command": "null-markdown.openSource",
					"when": "activeCustomEditorId == null-markdown.editor",
					"group": "navigation@1"
				}
			]
		},
		"keybindings": [
			{
				"command": "null-markdown.openPreview",
				"key": "ctrl+shift+v",
				"when": "editorLangId == markdown"
			},
			{
				"command": "null-markdown.openPreview",
				"key": "ctrl+shift+v",
				"when": "activeCustomEditorId == null-markdown.editor"
			},
			{
				"command": "null-markdown.openPreview",
				"key": "ctrl+k v",
				"when": "editorLangId == markdown"
			},
			{
				"command": "null-markdown.exportPdf",
				"key": "ctrl+shift+alt+p",
				"when": "editorLangId == markdown"
			},
			{
				"command": "null-markdown.openSlides",
				"key": "ctrl+shift+alt+s",
				"when": "editorLangId == markdown"
			}
		]
	},
	"scripts": {
		"build": "esbuild webview/editor/main.mjs --bundle --minify --format=iife --target=es2020 --outfile=lib/editor.js",
		"test": "node --test test/syncState.test.js test/imageSrc.test.js test/sync.test.mjs test/specs.test.mjs"
	},
	"dependencies": {
		"highlight.js": "^11.0.0",
		"katex": "^0.16.11",
		"markdown-it": "^14.2.0",
		"markdown-it-emoji": "^3.0.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-texmath": "^1.0.0",
		"mermaid": "^10.9.1"
	},
	"devDependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@lezer/markdown": "^1.8.0",
		"esbuild": "^0.28.2"
	}
}
