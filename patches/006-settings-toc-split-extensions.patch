@@ -164,7 +164,7 @@ export function createTOCIterator(model: TOCTreeModel | SettingsTreeGroupElement
 
 		return {
 			element: g,
-			collapsed: undefined,
+			collapsed: g.id === 'null' ? false : undefined, // Null IDE: keep the Null section open
 			collapsible: hasGroupChildren,
 			children: g instanceof SettingsTreeGroupElement ?
 				createTOCIterator(g, tree) :
