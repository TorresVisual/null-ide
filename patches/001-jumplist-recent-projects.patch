 	//#region Workspaces History
 
+	// Null IDE: retention for null-recent-projects.json (pinned entries are always kept).
+	private nullRecentProjectsMaxItems(): number {
+		const value = this.configurationService.getValue<number>('null.recentProjects.maxItems');
+		return typeof value === 'number' && Number.isFinite(value) ? Math.max(1, Math.floor(value)) : 50;
+	}
+
+	// Null IDE: write a sibling temp file, then rename over the store so readers never see a partial file.
+	private async writeNullRecentProjects(filePath: string, entries: unknown[]): Promise<void> {
+		const tempPath = `${filePath}.${process.pid}.tmp`;
+		try {
+			await fsPromises.writeFile(tempPath, JSON.stringify(entries, undefined, '\t'));
+			await fsPromises.rename(tempPath, filePath);
+		} catch (error) {
+			await fsPromises.rm(tempPath, { force: true }).catch(() => undefined);
+			throw error;
+		}
+	}
