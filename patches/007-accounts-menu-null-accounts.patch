+// Null IDE: null-accounts publishes the Accounts menu rows as the context key `null.accounts.menu`,
+// and the picture for the activity bar button as `null.accounts.avatar`. Pictures are `data:` URIs only.
+type NullAccountsMenuEntry = 'separator' | { label: string; description?: string; avatar?: string; provider?: 'github' | 'gitlab'; icon?: 'add' | 'gear'; enabled?: boolean; checked?: boolean; command: string; args?: unknown[] };
+
+const NULL_ACCOUNTS_AVATAR_KEY = 'null.accounts.avatar';
+const NULL_ACCOUNTS_AVATAR = /^data:image\/(?:png|jpeg|gif|webp);base64,[A-Za-z0-9+/=]+$/;
+
+function readNullAccountsAvatar(value: unknown): string | undefined {
+	return typeof value === 'string' && NULL_ACCOUNTS_AVATAR.test(value) ? value : undefined;
+}
+
+function readNullAccountsMenu(value: unknown): NullAccountsMenuEntry[] {
+	if (!Array.isArray(value)) {
+		return [];
+	}
+	return value.filter((e): e is NullAccountsMenuEntry => {
+		if (e === 'separator') {
+			return true;
+		}
+		if (typeof e !== 'object' || e === null) {
+			return false;
+		}
+		const entry = e as Record<string, unknown>;
+		return typeof entry.label === 'string' && typeof entry.command === 'string'
+			&& (entry.description === undefined || typeof entry.description === 'string')
+			&& (entry.avatar === undefined || readNullAccountsAvatar(entry.avatar) !== undefined)
+			&& (entry.provider === undefined || entry.provider === 'github' || entry.provider === 'gitlab')
+			&& (entry.icon === undefined || entry.icon === 'add' || entry.icon === 'gear')
+			&& (entry.enabled === undefined || typeof entry.enabled === 'boolean')
+			&& (entry.checked === undefined || typeof entry.checked === 'boolean')
+			&& (entry.args === undefined || Array.isArray(entry.args));
+	});
+}
